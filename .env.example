# Oracle MySQL Heatwave Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aram_tracker
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Node.js Server Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aram_tracker
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
PORT=3001

# League of Legends API
RIOT_API_KEY=your_riot_api_key

# Development
NODE_ENV=development

# Production (Render)
# MYSQL_HOST=your-render-db-host
# MYSQL_PORT=3306
# MYSQL_DATABASE=aram_tracker
# MYSQL_USER=your_render_db_user
# MYSQL_PASSWORD=your_render_db_password
# PORT=10000

# Client (for packaged app)
# REACT_APP_API_URL=https://your-app-name.onrender.com
